<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net8.0-windows: LibreHardwareMonitor backend. net8.0: macOS / Linux backends. -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>vimon</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vimon.Core\Vimon.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vimon.Cli.Tests" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\Vimon.Platform.Windows\Vimon.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <ProjectReference Include="..\Vimon.Platform.MacOS\Vimon.Platform.MacOS.csproj" />
    <ProjectReference Include="..\Vimon.Platform.Linux\Vimon.Platform.Linux.csproj" />
  </ItemGroup>
</Project>
